# macOS noise
.DS_Store

# Rust
/target/
**/*.rs.bk

# cc65 leaves object files beside the sources
targets/plus4/src/*.o
targets/plus4/*.o

# Baked headers are generated by `ascitty-bake` from the Rust core, and the
# generator is the source of truth.  They are regenerated by `make bake`
# before every target build, so committing them would only create a second
# copy that can silently disagree with the first.
targets/plus4/gen/*.h
targets/plus4/gen/*.inc

# Build output is generated - except the artifacts the README offers as
# downloads, which are tracked on purpose so those links resolve, and the
# sidecar checksums that describe them.
build/*
!build/ascitty.d64
!build/ascitty.prg
!build/*.sha256
!build/*.md5
!build/CHECKSUMS.txt
